meta {
  name: 4 - Points On Top
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/discount/calculate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "items": [
      {"name": "T-Shirt", "category": "CLOTHING", "unitPrice": 350},
      {"name": "Hat", "category": "ACCESSORIES", "unitPrice": 250},
      {"name": "Belt", "category": "ACCESSORIES", "unitPrice": 230}
    ],
    "campaigns": [
      {"type": "POINTS_ON_TOP", "points": 68}
    ]
  }
}

assert {
  res.status: eq 200
  res.body.totalPrice: eq 762.0
}
