meta {
  name: 2 - Percentage Coupon
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/discount/calculate
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "items": [
      {"name": "T-Shirt", "category": "CLOTHING", "unitPrice": 350},
      {"name": "Hat", "category": "ACCESSORIES", "unitPrice": 250}
    ],
    "campaigns": [
      {"type": "PERCENTAGE_COUPON", "percentage": 10}
    ]
  }
}

assert {
  res.status: eq 200
  res.body.totalPrice: eq 540.0
}
